# Tolk (TON) comby rules.
#
# Notes:
# - ton_common.rules now provides the shared TON-safe operator/control-flow
#   families for default --comby runs.
# - These rules mirror conservative Tolk-specific surface-syntax edits.

/*:[comment]*/ ==> DO_NOT_MUTATE

import :[rest] ==> DO_NOT_MUTATE

# Line-anchored comment replacement stays regex-only; this Comby layer has no
# safe line-scope guard for declaration/control-flow exclusions.

if (:[cond]) ==> if (!(:[cond]))
if (:[cond]) ==> if (false)
if (:[cond]) ==> if (true)

# Bitwise/logical operator shuffle.  \w+ holes keep us from swallowing whole
# type declarations while still matching SEND_MODE_* | SEND_MODE_* etc.
:[a] & :[b] ==> :[a] ^ :[b]

# Comment-replacement for standalone assert statements.
assert (:[cond]) throw :[err]; ==> // assert (:[cond]) throw :[err];
assert (:[cond]) throw :[err]; ==> assert (!(:[cond])) throw :[err];

assert (:[cond]) throw :[err]; ==> 
throw :[err]; ==> 
:[obj].save(:[args]); ==> 
contract.setData(:[args]); ==> 
acceptExternalMessage(); ==> 
commitContractDataAndActions(); ==> 
contract.setCodePostponed(:[args]); ==> 

# Non-literal / non-ton value initialisers (e.g. value: msgValue).
value: :[expr~[a-zA-Z0-9_.]+] ==> value: 0

# Comparison swaps inside assert and if.
assert (:[lhs] == :[rhs]) throw :[err] ==> assert (:[lhs] != :[rhs]) throw :[err]
assert (:[lhs] != :[rhs]) throw :[err] ==> assert (:[lhs] == :[rhs]) throw :[err]
assert (:[lhs] >= :[rhs]) throw :[err] ==> assert (:[lhs] > :[rhs]) throw :[err]
assert (:[lhs] >= :[rhs]) throw :[err] ==> assert (:[lhs] == :[rhs]) throw :[err]
assert (:[lhs] <= :[rhs]) throw :[err] ==> assert (:[lhs] < :[rhs]) throw :[err]
assert (:[lhs] <= :[rhs]) throw :[err] ==> assert (:[lhs] == :[rhs]) throw :[err]

if (:[lhs] == :[rhs]) ==> if (:[lhs] != :[rhs])
if (:[lhs] != :[rhs]) ==> if (:[lhs] == :[rhs])
if (:[lhs] >= :[rhs]) ==> if (:[lhs] > :[rhs])
if (:[lhs] >= :[rhs]) ==> if (:[lhs] == :[rhs])
if (:[lhs] <= :[rhs]) ==> if (:[lhs] < :[rhs])
if (:[lhs] <= :[rhs]) ==> if (:[lhs] == :[rhs])

lazy :[rest] ==> :[rest]
get fun :[rest] ==> fun :[rest]
@inline ==> @noinline
@noinline ==> @inline
@inline_ref ==> @inline
@pure ==> 
mutate :[param]: :[type] ==> :[param]: :[type]
fun :[name](:[before], :[arg]: :[type] = :[default], :[after]) ==> fun :[name](:[before], :[arg]: :[type], :[after])
fun :[name](:[arg]: :[type] = :[default], :[after]) ==> fun :[name](:[arg]: :[type], :[after])
fun :[name](:[before], :[arg]: :[type] = :[default]) ==> fun :[name](:[before], :[arg]: :[type])

varuint16 ==> varint16
varint16 ==> varuint16
varuint32 ==> varint32
varint32 ==> varuint32
:[lhs] *= :[rhs] ==> :[lhs] %= :[rhs]
:[lhs] %= :[rhs] ==> :[lhs] *= :[rhs]
as uint:[n~(?:[1-9]\d?|1\d\d|2[0-4]\d|25[0-6])] ==> as int:[n]
as int:[n~(?:[1-9]\d?|1\d\d|2[0-4]\d|25[0-6])] ==> as uint:[n]
:[expr]! ==> :[expr]
throwIfOpcodeDoesNotMatch: :[err] ==> throwIfOpcodeDoesNotMatch: 63
assertEndAfterReading: true ==> assertEndAfterReading: false
assertEndAfterReading: false ==> assertEndAfterReading: true
blockchain.now ==> blockchain.logicalTime
blockchain.logicalTime ==> blockchain.currentBlockLogicalTime
blockchain.currentBlockLogicalTime ==> blockchain.logicalTime
calculateSizeStrict(:[args]) ==> calculateSize(:[args])
calculateSize(:[args]) ==> calculateSizeStrict(:[args])
random.uint256 ==> random.getSeed
random.getSeed ==> random.uint256
